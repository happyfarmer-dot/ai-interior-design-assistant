# AI Interior Space Planning Assistant - Service Pipeline Configuration
# Copy this file to .env.local and fill in real API endpoints/keys to switch from built-in Demo Mode to Live AI Mode.

# Pipeline mode: "mock" (built-in interactive deterministic & procedural engine) | "live"
VITE_AI_PIPELINE_MODE=mock

# Vision / VLM API (Object Detection, Surface Segmentation, MEP Recognition)
VITE_VISION_API_ENDPOINT=https://api.openai.com/v1/chat/completions
VITE_VISION_API_KEY=

# Diffusion / Inpainting / Style Transfer API (e.g. Replicate, Stability, ComfyUI)
VITE_RENDER_API_ENDPOINT=https://api.replicate.com/v1/predictions
VITE_RENDER_API_KEY=

# LLM Constraint Parser API (Natural Language -> JSON Design Constraints)
VITE_LLM_API_ENDPOINT=https://api.openai.com/v1/chat/completions
VITE_LLM_API_KEY=

# Retail Visual Search Endpoint (Optional external product matcher)
VITE_PRODUCT_SEARCH_ENDPOINT=
